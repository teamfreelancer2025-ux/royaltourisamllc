{
  "version": 2,
  "builds": [
    {
      "src": "dist-server/server.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["dist/**", "dist-server/**"] }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/dist/client/assets/$1"
    },
    {
      "src": "/favicon.png",
      "dest": "/dist/client/favicon.png"
    },
    {
      "src": "/logo-premium.webp",
      "dest": "/dist/client/logo-premium.webp"
    },
    {
      "src": "/(.*)",
      "dest": "dist-server/server.js"
    }
  ]
}
