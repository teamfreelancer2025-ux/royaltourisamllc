{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "dist-server/server.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["dist/**", "dist-server/**"] }
    }
  ],
  "routes": [
    {
      "src": "/_assets/(.*)",
      "dest": "/dist/client/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "dist-server/server.js"
    }
  ],
  "outputDirectory": "dist/client"
}
