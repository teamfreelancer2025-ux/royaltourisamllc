{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "outDir": "./dist-server" // Output compiled server files here
  },
  "include": ["vite.config.ts", "server.ts"], // Include server.ts for compilation
  "exclude": ["node_modules", "dist", "src", "public"]
}

